{
  "task": "Repair PipeForge incremental ETL so the warehouse stays correct under incremental, adversarial, and interrupted ingest.",
  "authoritative_source": "task/instruction.md",
  "requirements": [
    {
      "id": "R1",
      "behavior": "Rerunning unchanged input is idempotent.",
      "edge_cases": ["three identical runs", "empty incoming directory"],
      "tests": [
        "tests/test_idempotency.py::test_three_runs_of_the_same_file_are_idempotent",
        "tests/test_empty_incoming.py::test_empty_incoming_directory_completes_with_zero_events",
        "tests/test_randomized.py::test_randomized_dataset_matches_independent_oracle"
      ],
      "mandatory": true
    },
    {
      "id": "R2",
      "behavior": "Duplicate events are handled globally across files; one logical row per event_id.",
      "edge_cases": ["in-file duplicate", "cross-file duplicate"],
      "tests": [
        "tests/test_duplicates.py::test_identical_duplicate_inside_one_file",
        "tests/test_duplicates.py::test_duplicate_event_across_two_files"
      ],
      "mandatory": true
    },
    {
      "id": "R3",
      "behavior": "Conflicting reuse of an event_id does not overwrite the original row; the conflict is quarantined.",
      "edge_cases": ["same id, different amount"],
      "tests": [
        "tests/test_duplicates.py::test_conflicting_duplicate_keeps_original",
        "tests/test_regression.py::test_mixed_rerun_duplicate_timezone_and_late_data"
      ],
      "mandatory": true
    },
    {
      "id": "R4",
      "behavior": "Malformed records are quarantined; valid siblings still load.",
      "edge_cases": ["broken JSON mid-file", "missing required field"],
      "tests": [
        "tests/test_malformed_records.py::test_broken_json_line_is_quarantined_and_valid_rows_survive",
        "tests/test_malformed_records.py::test_missing_event_id_is_quarantined"
      ],
      "mandatory": true
    },
    {
      "id": "R5",
      "behavior": "Monetary values are aggregated as exact integer minor units.",
      "edge_cases": ["0.10 repeated", "10.07", "99.99"],
      "tests": [
        "tests/test_money_precision.py::test_repeated_decimal_amounts_sum_exactly"
      ],
      "mandatory": true
    },
    {
      "id": "R6",
      "behavior": "Timezone-aware timestamps normalize to UTC; naive timestamps are quarantined.",
      "edge_cases": ["+05:30 crossing UTC midnight", "naive ISO string"],
      "tests": [
        "tests/test_timezone_handling.py::test_offset_crossing_utc_midnight_lands_on_previous_utc_date",
        "tests/test_timezone_handling.py::test_naive_timestamp_is_quarantined"
      ],
      "mandatory": true
    },
    {
      "id": "R7",
      "behavior": "Additive unknown schema fields do not reject a valid event.",
      "edge_cases": ["device_type, app_version, experiment"],
      "tests": [
        "tests/test_schema_evolution.py::test_extra_fields_are_tolerated"
      ],
      "mandatory": true
    },
    {
      "id": "R8",
      "behavior": "Late-arriving records update historical UTC metrics without changing later days.",
      "edge_cases": ["September 1 after September 3/4 already aggregated"],
      "tests": [
        "tests/test_late_arrivals.py::test_late_september_first_updates_history_without_corrupting_later_days"
      ],
      "mandatory": true
    },
    {
      "id": "R9",
      "behavior": "Interrupted ingestion recovers to the same warehouse as a clean run.",
      "edge_cases": ["fail after N records", "fail after write before checkpoint"],
      "tests": [
        "tests/test_crash_recovery.py::test_crash_after_n_records_then_rerun_matches_clean_run",
        "tests/test_crash_recovery.py::test_checkpoint_not_success_until_ingestion_finishes"
      ],
      "mandatory": true
    },
    {
      "id": "R10",
      "behavior": "A file is not recorded as successfully processed until ingestion finishes safely.",
      "edge_cases": ["failure before commit leaves zero events and no success checkpoint"],
      "tests": [
        "tests/test_atomicity.py::test_failure_before_commit_leaves_no_partial_success",
        "tests/test_crash_recovery.py::test_checkpoint_not_success_until_ingestion_finishes"
      ],
      "mandatory": true
    },
    {
      "id": "R11",
      "behavior": "New files ingest incrementally; pre-existing warehouse rows are not wiped.",
      "edge_cases": ["second wave", "seeded row before first run"],
      "tests": [
        "tests/test_incremental_processing.py::test_new_file_is_added_without_duplicating_old_events",
        "tests/test_incremental_processing.py::test_preexisting_warehouse_row_is_not_wiped"
      ],
      "mandatory": true
    },
    {
      "id": "R12",
      "behavior": "Same filename with changed bytes is new input; event_id rules still apply.",
      "edge_cases": ["batch.jsonl rewritten"],
      "tests": [
        "tests/test_changed_file.py::test_changed_content_keeps_filename_but_ingests_new_logical_events"
      ],
      "mandatory": true
    },
    {
      "id": "R13",
      "behavior": "CLI remains functional and prints documented run/status fields.",
      "edge_cases": ["run then status against isolated settings"],
      "tests": [
        "tests/test_cli.py::test_cli_run_and_status_print_documented_fields"
      ],
      "mandatory": true
    },
    {
      "id": "R14",
      "behavior": "Dashboard remains functional and run/status/health use the pipeline.",
      "edge_cases": ["health before run", "POST /api/run writes warehouse rows"],
      "tests": [
        "tests/test_dashboard_api.py::test_dashboard_health_status_and_run_use_pipeline"
      ],
      "mandatory": true
    },
    {
      "id": "R15",
      "behavior": "Happy-path ingestion of a valid file loads events, metrics, and a completed run.",
      "edge_cases": ["ten purchase events"],
      "tests": [
        "tests/test_basic_ingestion.py::test_basic_ingestion_loads_ten_events"
      ],
      "mandatory": true
    },
    {
      "id": "R16",
      "behavior": "Independent oracle on a seeded multi-file dataset including extras, duplicates, and late rows.",
      "edge_cases": ["40-100 events", "3-6 files", "UUID ids"],
      "tests": [
        "tests/test_randomized.py::test_randomized_dataset_matches_independent_oracle"
      ],
      "mandatory": true
    }
  ],
  "assumptions": [
    "Harbor/Docker grades only Python ETL via pytest -q /grader/tests. Node/Next.js is not scored.",
    "Frontend visual quality is subjective and is not a mandatory automated requirement.",
    "Quarantine reason text may vary; tests only require conflict/duplicate wording where specified.",
    "CLI wording may vary as long as documented field labels are present."
  ],
  "optional_or_human": [
    {
      "id": "H1",
      "behavior": "Control-center aesthetics, typography, and animation taste.",
      "verification": "Human visual review only. Automated tests cannot prove design quality."
    }
  ]
}
